<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Splitmate Final Project</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Final_Project.styles.css" asp-append-version="true" />
</head>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var title = ViewData["Title"] as string ?? string.Empty;
    var userName = User.Identity?.Name ?? "User";
    var roleName = User.IsInRole("Admin") ? "Admin" : "Member";
    var initial = string.IsNullOrWhiteSpace(userName) ? "U" : userName[..1].ToUpperInvariant();
}
<body class="@(isAuthenticated ? "app-body" : "auth-body")">
    @if (isAuthenticated)
    {
        <div class="app-container">
            <header class="app-topbar">
                <a class="app-brand" asp-controller="Home" asp-action="Index" aria-label="Splitmate home">
                    <img class="logo-mark" src="~/images/splitmate-mark.svg" alt="" />
                    <span class="logo-wordmark">Splitmate</span>
                </a>

                <nav class="top-nav" aria-label="Primary navigation">
                    <a asp-controller="Home" asp-action="Index" class="top-nav-item @(title == "Dashboard" ? "active" : "")" data-nav-key="home">
                        <span class="top-nav-icon">H</span>
                        <span>Home</span>
                    </a>
                    <a asp-controller="Home" asp-action="Expenses" class="top-nav-item @(title == "Expenses" || title == "Balances" ? "active" : "")" data-nav-key="split">
                        <span class="top-nav-icon">$</span>
                        <span>Split</span>
                    </a>
                    <a asp-controller="Home" asp-action="Tasks" class="top-nav-item @(title == "Tasks" ? "active" : "")" data-nav-key="tasks">
                        <span class="top-nav-icon">T</span>
                        <span>Tasks</span>
                    </a>
                    <a asp-controller="Home" asp-action="Notes" class="top-nav-item @(title == "Notes" ? "active" : "")" data-nav-key="notes">
                        <span class="top-nav-icon">N</span>
                        <span>Notes</span>
                    </a>
                </nav>

                <div class="account-area">
                    <details class="account-menu">
                        <summary aria-label="Open account menu">
                            <span class="user-avatar">@initial</span>
                            <span class="account-name">@userName</span>
                        </summary>
                        <div class="account-panel">
                            <div class="account-panel-header">
                                <span class="user-avatar">@initial</span>
                                <div class="user-details">
                                    <span class="profile-label">Account</span>
                                    <span class="user-name">@userName</span>
                                    <span class="user-email">@roleName</span>
                                </div>
                            </div>
                            <a asp-controller="Home" asp-action="Groups" class="account-menu-item">Groups</a>
                            <a asp-controller="Home" asp-action="Balances" class="account-menu-item">Payments</a>
                            <form asp-controller="Home" asp-action="Logout" method="post">
                                <button type="submit" class="account-menu-item account-menu-danger">Logout</button>
                            </form>
                        </div>
                    </details>
                </div>
            </header>

            <main role="main" class="main-content">
                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="alert alert-success app-alert" role="status">@statusMessage</div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger app-alert" role="alert">@errorMessage</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
